      "provider": "local",
      "name": "MiniMax H3",
      "maker": "MiniMax",
      "mark": "MM",
      "match": { "baseKey": "minimax", "family": "minimax" },
      "desc": {
        "fr": "Mouvements naturels et visages expressifs. Va jusqu’à 15 s et fait le son. Travaille en 24 i/s, jusqu’à 768p (à essayer au-delà de 720p).",
