        { "match": ".*", "tag": { "fr": "Images-clés", "en": "Keyframes" },
          "desc": { "fr": "Anime une image de début, et rejoint une image de fin si tu en donnes une.", "en": "Animates a start image, and reaches an end image if you give one." } }
      ],
      "limits": { "seconds": [2, 15], "fps": [24], "resolutions": ["540", "720", "768"], "audio": true,
        "inputs": ["start", "end", "keys", "prompt", "refs", "refVideos", "refAudios", "video", "audio", "guide", "look", "mask"] },
