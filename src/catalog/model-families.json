{
  "version": 1,
  "_doc": "Profils des familles de modèles (SPEC §22) : nom, fabricant, monogramme, phrase « à quoi ça sert » (FR/EN), variantes et limites. Même forme pour le local et, plus tard, le cloud. Lu par l'interface (src/js/nodes/profiles.js) et par le moteur (electron/engine/patch.js limits). Les limites locales sont celles vérifiées au labo ; un « à essayer » ne s'ouvre qu'après un essai GPU validé à l'œil.",
  "families": {
    "ltx": {
      "provider": "local",
      "name": "LTX 2.5",
      "maker": "Lightricks",
      "mark": "LT",
      "match": { "baseKey": "ltx", "family": "ltx" },
      "desc": {
        "fr": "Le plus polyvalent : anime une image, part d’un texte, suit un guide ou rend une scène 3D photoréaliste. Fait aussi le son, et accepte tes personnages (LoRA).",
        "en": "The most versatile: animates an image, starts from text, follows a guide or turns a 3D scene photoreal. Makes sound too, and takes your characters (LoRA)."
      },
      "variants": [
        { "match": "nvfp4|rtx ?50", "tag": { "fr": "Rapide", "en": "Fast" },
          "desc": { "fr": "Même résultat, plus rapide sur les cartes RTX 50.", "en": "Same result, faster on RTX 50 cards." } },
        { "match": ".*", "tag": { "fr": "Standard", "en": "Standard" },
          "desc": { "fr": "Le choix sûr, qualité maximale.", "en": "The safe pick, best quality." } }
      ],
      "limits": { "seconds": [2, 10], "fps": [24, 25, 30], "resolutions": ["540", "720", "1080"], "audio": true,
        "inputs": ["start", "end", "keys", "sheet", "prompt", "guide", "look", "mask", "video"] },
      "kind": "video",
      "main": ["start"],
      "workflows": [
        { "id": "real", "executor": "real", "cap": "3d-to-real", "as": "real",
