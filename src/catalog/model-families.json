          "ports": { "video": {}, "look": {} }, "required": ["video"],
          "params": ["prompt", "keepBlacks", "lora", "loraStrength", "seed"] },
        { "id": "guided", "executor": "guided", "cap": "guided-video", "as": "guided",
          "label": { "fr": "Vidéo guidée", "en": "Guided video" },
          "ports": { "guide": {}, "look": {}, "mask": {} }, "required": ["guide"],
          "params": ["prompt", "follow", "strength", "resolution", "lora", "loraStrength", "seed"] },
        { "id": "i2v", "executor": "i2v", "cap": "image-to-video", "as": "i2v",
          "label": { "fr": "Animer une image", "en": "Animate an image" },
          "ports": { "start": {}, "end": {}, "keys": { "multi": true, "max": 4, "trial": true }, "sheet": {} }, "required": ["start"],
          "params": ["prompt", "duration", "format", "resolution", "fps", "lora", "loraStrength", "enhance", "seed"] },
        { "id": "t2v", "executor": "t2v", "cap": "text-to-video", "as": "t2v", "promptRequired": true,
          "label": { "fr": "Vidéo depuis un texte", "en": "Video from text" },
          "ports": {}, "required": [],
          "params": ["prompt", "duration", "format", "resolution", "lora", "loraStrength", "negative", "enhance", "seed"] }
      ]
    },
