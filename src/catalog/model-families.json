          "params": ["prompt", "duration", "format", "resolution", "fidelity", "seed"] },
        { "id": "guided", "executor": "guided", "cap": "guided-video", "as": "guided",
          "label": { "fr": "Vidéo guidée", "en": "Guided video" },
          "ports": { "guide": {}, "look": {}, "mask": {} }, "required": ["guide"],
          "params": ["prompt", "follow", "strength", "resolution", "seed"] },
        { "id": "i2v", "executor": "i2v", "cap": "image-to-video", "as": "i2v",
          "label": { "fr": "Animer une image", "en": "Animate an image" },
          "ports": { "start": {}, "end": {}, "keys": { "multi": true, "max": 4 }, "audio": { "trial": true } },
          "required": ["start"],
          "params": ["prompt", "duration", "format", "resolution", "lora", "loraStrength", "seed"] },
        { "id": "extend", "executor": "i2v", "cap": "image-to-video", "as": "i2v", "promptRequired": true,
          "label": { "fr": "Prolonger une vidéo", "en": "Extend a video" },
          "ports": { "video": {} }, "required": ["video"],
          "params": ["prompt", "duration", "resolution", "lora", "loraStrength", "seed"] },
        { "id": "t2v", "executor": "i2v", "cap": "image-to-video", "as": "i2v", "promptRequired": true,
          "label": { "fr": "Vidéo depuis un texte", "en": "Video from text" },
          "ports": { "keys": { "multi": true, "max": 4 }, "audio": { "trial": true } }, "required": [],
          "params": ["prompt", "duration", "format", "resolution", "lora", "loraStrength", "seed"] }
      ]
    },
